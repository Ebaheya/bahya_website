# ---------------------------------------------------------------------------
# Production environment template for docker-compose.prod.yml
#
#   cp deploy/env.production.example .env
#   # then fill in every CHANGE_ME value with a real secret
#
# This .env lives at the repo root on the VPS and is gitignored. It is the
# single source of truth consumed by both Compose interpolation (DB creds) and
# the api container (env_file). Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# ---- Application ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- PostgreSQL ----
# These three feed the `postgres` service. DATABASE_URL must use the compose
# service hostname `postgres` and match the user/password/db below.
POSTGRES_USER=bahya
POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password
POSTGRES_DB=mental_health_clinic
DATABASE_URL=postgresql://bahya:CHANGE_ME_strong_postgres_password@postgres:5432/mental_health_clinic?schema=public

# ---- MongoDB ----
# These feed the `mongo` service. MONGODB_URI must use the compose service
# hostname `mongo` and match the root credentials below.
MONGO_INITDB_ROOT_USERNAME=bahya
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_mongo_password
MONGODB_URI=mongodb://bahya:CHANGE_ME_strong_mongo_password@mongo:27017/bahya_activity?authSource=admin

# ---- Auth / JWT (use long random strings, >= 32 chars) ----
JWT_ACCESS_SECRET=CHANGE_ME_long_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_long_random_refresh_secret_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Used ONCE to create the first ADMIN, then should be rotated/removed.
BOOTSTRAP_SECRET=CHANGE_ME_bootstrap_secret_at_least_16_chars

# ---- CORS ----
# Explicit allow-list is REQUIRED in production (wildcard is rejected).
# The Vercel dashboard frontend lives at dashboard.refk.tech.
CORS_ORIGINS=https://dashboard.refk.tech

# Behind nginx, so trust the X-Forwarded-For header for real client IPs.
TRUST_PROXY=true

# ---- Email / password reset ----
# Point at a real SMTP provider for production password-reset email.
SMTP_HOST=CHANGE_ME_smtp_host
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASS=CHANGE_ME_smtp_password
SMTP_FROM=noreply@refk.tech
RESET_TOKEN_TTL_MINUTES=30
APP_URL=https://dashboard.refk.tech

# ---- Firebase Cloud Messaging (optional) ----
# Leave disabled unless push is configured. To enable, set FCM_ENABLED=true and
# provide the base64-encoded service account JSON.
FCM_ENABLED=false
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
