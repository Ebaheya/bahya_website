# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mental_health_clinic?schema=public

# MongoDB (Mongoose) - activity data: audit logs, interventions, notifications, chat
# Matches backend/docker-compose.yml `mongo` service.
# Production deployments MUST override these credentials.
MONGO_INITDB_ROOT_USERNAME=bahya
MONGO_INITDB_ROOT_PASSWORD=bahya
MONGODB_URI=mongodb://bahya:bahya@localhost:27017/bahya_activity?authSource=admin

# Auth / JWT
JWT_ACCESS_SECRET=dev_access_secret_please_change_me_to_a_long_random_string_123456
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_me_to_a_long_random_string_654321
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Bootstrap (used ONCE to create the first ADMIN when DB has no admin yet)
BOOTSTRAP_SECRET=create_admin_2026_secure

# CORS: comma-separated list of allowed origins.
# Use * only in development. Production REQUIRES an explicit list or the server will refuse to start.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Email / password reset
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@bahya.health
RESET_TOKEN_TTL_MINUTES=30
APP_URL=http://localhost:3000
