{
  "name": "mental-health-clinic-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Mental Health Clinic API — auth module (Express + Prisma + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "audit:migrate": "ts-node --transpile-only scripts/migrate-audit-to-mongo.ts",
    "seed:forms": "ts-node --transpile-only prisma/seed/forms.ts",
    "seed:services": "ts-node --transpile-only prisma/seed/services.ts",
    "seed": "ts-node --transpile-only prisma/seed/index.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.23.1",
    "nodemailer": "^8.0.7",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed/index.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.0",
    "jest": "^30.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0"
  }
}
