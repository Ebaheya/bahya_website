              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/{{approveServiceId}}/requests",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", "{{approveServiceId}}", "requests"]
            },
            "description": "Expected 409 DUPLICATE_SERVICE_REQUEST."
          }
        },
        {
          "name": "Staff Queue",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests?status=PENDING&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests"],
              "query": [
                { "key": "status", "value": "PENDING" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Dashboard Summary",
          "request": {
            "method": "GET",
