              "raw": "{{baseUrl}}/api/v1/services?kind=EDUCATIONAL&q=Postman&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"],
              "query": [
                { "key": "kind", "value": "EDUCATIONAL" },
                { "key": "q", "value": "Postman" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
