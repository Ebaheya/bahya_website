              "raw": "{\n  \"categoryId\": \"{{serviceCategoryId}}\",\n  \"name\": \"Postman Literacy Class - Approve\",\n  \"locationBranch\": \"Main Branch\",\n  \"startDate\": \"2026-07-20\",\n  \"startTime\": \"10:00\",\n  \"capacity\": 2\n}"
            }
