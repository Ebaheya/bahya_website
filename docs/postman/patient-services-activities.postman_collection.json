{
  "info": {
    "name": "Mental Health Clinic API - Patient Services & Activities",
    "description": "Feature 006 patient services and activities. Covers service categories, services, patient join requests, staff queue/summary, approve/reject/cancel, and a management RBAC negative.\n\nEnvironment variables expected: baseUrl, accessToken (ADMIN), patientToken. Optional: doctorToken.\nCollection variables captured while running: serviceCategoryId, approveServiceId, approveRequestId, cancelServiceId, cancelRequestId, rejectServiceId, rejectRequestId.\n\nAll routes are mounted under {{baseUrl}}/api/v1.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "serviceCategoryId", "value": "" },
    { "key": "approveServiceId", "value": "" },
    { "key": "approveRequestId", "value": "" },
    { "key": "cancelServiceId", "value": "" },
    { "key": "cancelRequestId", "value": "" },
    { "key": "rejectServiceId", "value": "" },
    { "key": "rejectRequestId", "value": "" }
  ],
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Service Category (ADMIN/DOCTOR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created or duplicate category handled', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('serviceCategoryId', body.id);",
                  "  pm.environment.set('serviceCategoryId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Education Services Postman\",\n  \"kind\": \"EDUCATIONAL\",\n  \"iconKey\": \"school\",\n  \"color\": \"#6CCB4F\"\n}"
            },
            "description": "Creates a custom category. If a duplicate name already exists, use List Categories and set {{serviceCategoryId}} manually from a seeded/default category."
          }
        },
        {
          "name": "List Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('categories list succeeds', function () {",
                  "  pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const list = Array.isArray(body) ? body : (body.data || []);",
                  "if (!pm.collectionVariables.get('serviceCategoryId') && list[0] && list[0].id) {",
                  "  pm.collectionVariables.set('serviceCategoryId', list[0].id);",
                  "  pm.environment.set('serviceCategoryId', list[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-categories?kind=EDUCATIONAL&isActive=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-categories"],
              "query": [
                { "key": "kind", "value": "EDUCATIONAL" },
                { "key": "isActive", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "Patient Cannot Create Category (403)",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-categories"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Blocked Category\",\n  \"kind\": \"OTHER\",\n  \"iconKey\": \"block\",\n  \"color\": \"#FF4FA3\"\n}"
            },
            "description": "Expected 403 FORBIDDEN."
          }
        }
      ]
    },
    {
