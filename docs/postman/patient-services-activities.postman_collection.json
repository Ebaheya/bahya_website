          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{approveRequestId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests", "{{approveRequestId}}", "approve"]
            }
          }
        },
        {
          "name": "Patient My Requests",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{patientToken}}", "type": "string" }]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "service-requests", "my"]
            }
          }
        }
      ]
    },
